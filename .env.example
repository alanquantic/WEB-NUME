# API (NestJS) — default port 3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Frontend (Next.js) — uses 3001 when 3000 is taken by the API
NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_ACCESS_COOKIE=nume_at
AUTH_REFRESH_COOKIE=nume_rt


# Secreto compartido con la API y la tienda: con él la web reenvía la IP real
# del visitante (X-Nume-Client-IP) para el rate limit de la API. Mismo valor en
# los 3; solo del servidor (sin NEXT_PUBLIC_). Opcional: sin él no se envía.
INTERNAL_PROXY_SECRET=
